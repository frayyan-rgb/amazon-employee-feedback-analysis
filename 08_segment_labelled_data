    {
      "cell_type": "code",
      "source": [
        "df[\"is_new\"] = df[\"employee_type\"].str.contains(\"less than 1 year\", na=False)\n",
        "df[\"is_former\"] = df[\"employee_type\"].str.contains(\"Former\", na=False)\n",
        "\n",
        "summary = (\n",
        "    df.groupby(\"Segment\")\n",
        "    .agg(\n",
        "        reviews=(\"review_id\", \"count\"),\n",
        "        avg_overall=(\"rating_overall\", \"mean\"),\n",
        "        pct_former=(\"is_former\", \"mean\"),\n",
        "        pct_under_1yr=(\"is_new\", \"mean\"),\n",
        "    )\n",
        "    .round(2)\n",
        "    .sort_values(\"reviews\", ascending=False)\n",
        ")\n",
        "summary"
