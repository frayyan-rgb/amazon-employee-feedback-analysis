    {
      "cell_type": "code",
      "source": [
        "CORPORATE = re.compile(\n",
        "    r\"manager|engineer|\\bhr\\b|\\bhra\\b|human resource|program|software|\\bsde\\b|\"\n",
        "    r\"it support|t[eé]cnico|reliability\",\n",
        "    re.IGNORECASE,\n",
        ")\n",
        "\n",
        "def assign_segment(row):\n",
        "    status = row[\"employee_status\"]\n",
        "    title = str(row[\"employee_job_title\"]) if pd.notna(row[\"employee_job_title\"]) else \"\"\n",
        "\n",
        "    if status in (\"CONTRACT\", \"INTERN\", \"FREELANCE\"):\n",
        "        return \"Contract, Intern & Freelance\"\n",
        "    if CORPORATE.search(title):\n",
        "        return \"Managers & Corporate Roles\"\n",
        "    if status == \"PART_TIME\" or \"seasonal\" in title.lower():\n",
        "        return \"Part-Time & Seasonal Associates\"\n",
        "    if status == \"REGULAR\":\n",
        "        return \"Full-Time Associates\"\n",
        "    return \"Associates (Status Not Reported)\""
      ],
      "metadata": {
        "id": "yGt74wc_KhrO"
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df[\"Segment\"] = df.apply(assign_segment, axis=1)\n",
        "df.to_csv(\"Project5_Labeled_Segments.csv\", index=False)"
      ],
